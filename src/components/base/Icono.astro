---
// Iconos de línea (trazo 1.5 px, currentColor) y la marca [+] estática. Decorativos por defecto;
// con `titulo` se anuncian como imagen. El [+] animado (hero, buscador, Copiar) está en src/scripts/icono-marca.ts.
export type NombreIcono =
  | 'marca' | 'buscar' | 'flecha' | 'externo' | 'copiar' | 'check' | 'aviso' | 'info' | 'consejo'
  | 'peligro' | 'menu' | 'cerrar' | 'github' | 'rss' | 'reloj' | 'nivel';

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  clase?: string;
  titulo?: string;
}
const { nombre, tamano = 16, clase, titulo } = Astro.props;

// Marca [+] v1 (docs/marca/): cara #fafafa con borde negro y sombra #fde047 dentro de la caja, abajo a la
// derecha (retícula 26 × 26). Por debajo de 24 px, la versión pequeña del kit: borde y trazos más gruesos.
const MARCA = tamano < 24 ? { x: 0.8, lado: 22, borde: 1.6, trazo: 2.8 } : { x: 0.6, lado: 22.4, borde: 1.2, trazo: 2.2 };

const TRAZOS: Record<Exclude<NombreIcono, 'marca'>, string> = {
  buscar: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4.2-4.2"/>',
  flecha: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  externo: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  copiar: '<rect x="8" y="8" width="12" height="12" rx="1"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  aviso: '<path d="M12 3.5 2.5 20h19L12 3.5z"/><path d="M12 10v4.5M12 17.2v.01"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/>',
  consejo: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2h5c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3z"/>',
  peligro: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/><path d="M12 8.5V13M12 16v.01"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  cerrar: '<path d="M6 6l12 12M18 6 6 18"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.1-1.3-.3-2.5-1-3.5.3-1.2.3-2.4 0-3.5 0 0-1 0-3 1.5a13 13 0 0 0-8 0C6 2 5 2 5 2c-.3 1.2-.3 2.4 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.4.5-.7 1.1-.9 1.7-.2.6-.2 1.2-.1 1.8v4"/><path d="M9 18c-4.5 2-5-2-7-2"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  nivel: '<path d="M5 20v-5M12 20V10M19 20V4"/>',
};
---
{nombre === 'marca' ? (
  <svg class:list={['mark', clase]} width={tamano} height={tamano} viewBox="0 0 26 26" role={titulo ? 'img' : undefined} aria-label={titulo} aria-hidden={titulo ? undefined : 'true'}>
    <path d="M23.6 3H26V26H3V23.6H23.6Z" fill="#fde047" />
    <rect x={MARCA.x} y={MARCA.x} width={MARCA.lado} height={MARCA.lado} fill="#fafafa" stroke="#000" stroke-width={MARCA.borde} />
    <path d="M7.8 4.8H4.8v14h3M15.8 4.8h3v14h-3M11.8 9.05v6M8.8 12.05h6" fill="none" stroke="#000" stroke-width={MARCA.trazo} stroke-linecap="square" />
  </svg>
) : (
  <svg class:list={['ico', clase]} width={tamano} height={tamano} viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role={titulo ? 'img' : undefined} aria-label={titulo} aria-hidden={titulo ? undefined : 'true'} set:html={TRAZOS[nombre]} />
)}
