---
// Tres cuadraditos (.dots) para nivel (inicial · intermedio · avanzado) o complejidad (1–3), con texto accesible.
interface Props {
  valor: 1 | 2 | 3 | number | 'inicial' | 'intermedio' | 'avanzado';
  etiqueta?: string;     // «Nivel», «Complejidad», «Coste»…
  texto?: boolean;       // muestra también la palabra junto a los cuadraditos
}
const { valor, etiqueta = 'Nivel', texto = false } = Astro.props;
const NIVELES = ['inicial', 'intermedio', 'avanzado'] as const;
const n = typeof valor === 'number' ? Math.max(1, Math.min(3, Math.round(valor))) : NIVELES.indexOf(valor) + 1;
const palabra = typeof valor === 'string' ? valor : `${n} de 3`;
---
<span class="dif">
  <span class="dots" role="img" aria-label={`${etiqueta}: ${palabra}`}>
    {[1, 2, 3].map((i) => <i class:list={[{ on: i <= n }]}></i>)}
  </span>
  {texto && <span aria-hidden="true">{palabra}</span>}
</span>
