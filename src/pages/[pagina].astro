---
// Páginas sueltas: /empieza-aqui/ /manifiesto/ /contribuir/ /sobre/ /licencia/
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import PaginaLayout from '../layouts/PaginaLayout.astro';
import TestNivel from '../components/aprender/TestNivel.astro';
import { publicados } from '../lib/contenido';
import { ldArticulo } from '../lib/jsonld';

export const getStaticPaths = (async () =>
  (await publicados('paginas')).map((e) => ({ params: { pagina: e.id }, props: { e } }))) satisfies GetStaticPaths;

const { e } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content } = await render(e);
---
<PaginaLayout entrada={e} titulo={e.data.titulo} descripcion={e.data.descripcion} lead={e.data.descripcion} seccion=""
  migas={[{ href: '/', texto: 'Inicio' }, { texto: e.data.titulo }]} jsonld={{ ...ldArticulo(e), '@type': 'WebPage' }}>
  <Content />
  {e.id === 'empieza-aqui' && <TestNivel />}
</PaginaLayout>
