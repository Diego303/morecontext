---
// Provisional (fase 1): una página por entrada, en su URL definitiva, para comprobar que todo
// el contenido se renderiza y que no quedan wikilinks ni enlaces internos rotos.
// Se borra en la fase 4, cuando cada sección tenga su ruta y su layout.
import { render, type CollectionEntry, type CollectionKey } from 'astro:content';
import { CARPETA, publicados, urlDe } from '../lib/contenido';

export async function getStaticPaths() {
  const listas = await Promise.all((Object.keys(CARPETA) as CollectionKey[]).map((c) => publicados(c)));
  return listas.flat().map((e) => ({ params: { ruta: urlDe(e).slice(1, -1) }, props: { e } }));
}

type Props = { e: CollectionEntry<CollectionKey> };
const { e } = Astro.props;
const { Content } = await render(e);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{e.data.titulo} · MoreContext</title>
  </head>
  <body>
    <nav aria-label="Migas"><a href="/">Contenido cargado</a> / {e.collection}</nav>
    <main>
      <h1>{e.data.titulo}</h1>
      <p>{e.data.descripcion}</p>
      <Content />
    </main>
  </body>
</html>

<style is:global>
  /* Mínimo para leer sin desbordes hasta que llegue el design system (fase 2). */
  :root { color-scheme: dark; }
  body { margin: 0 auto; max-width: 72rem; padding: 24px max(16px, env(safe-area-inset-left, 0px)); font-family: system-ui, sans-serif; line-height: 1.5; }
  main { overflow-wrap: anywhere; }
  pre, table { display: block; max-width: 100%; overflow-x: auto; }
  pre { overflow-wrap: normal; }
</style>
