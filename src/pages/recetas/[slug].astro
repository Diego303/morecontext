---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import LecturaLayout from '../../layouts/LecturaLayout.astro';
import { publicados } from '../../lib/contenido';
import { ldArticulo } from '../../lib/jsonld';
import { TEMA } from '../../lib/nombres';

export const getStaticPaths = (async () =>
  (await publicados('recetas')).map((e) => ({ params: { slug: e.id }, props: { e } }))) satisfies GetStaticPaths;

const { e } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content, headings } = await render(e);
---
<LecturaLayout entrada={e} headings={headings} seccion="recetas" jsonld={ldArticulo(e)}
  migas={[{ href: '/', texto: 'Inicio' }, { href: '/recetas/', texto: 'Recetas' }, { texto: e.data.titulo }]}>
  <span slot="sobre-titulo" class="label sobre-titulo"><b>Receta</b> · {TEMA[e.data.tema]}</span>
  <div slot="cabecera" class="ficha-datos">
    <dl class="datos">
      <div><dt>Tiempo</dt><dd>~{e.data.minutos} min</dd></div>
      <div><dt>Tema</dt><dd>{TEMA[e.data.tema]}</dd></div>
      {e.data.stack.length > 0 && <div><dt>Stack</dt><dd>{e.data.stack.join(' · ')}</dd></div>}
    </dl>
  </div>
  <Content />
</LecturaLayout>
