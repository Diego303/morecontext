---
// Carcasa de todas las páginas: <head> (SEO, Open Graph, iconos, JSON-LD), cabecera, pie, buscador y scripts.
import '../styles/global.css';
import { SITIO } from '../config/sitio';
import Cabecera from '../components/base/Cabecera.astro';
import Pie from '../components/base/Pie.astro';
import Buscador from '../components/base/Buscador.astro';
import SaltarContenido from '../components/base/SaltarContenido.astro';

export interface Props {
  titulo: string;
  descripcion: string;
  seccion?: string;
  tipo?: 'website' | 'article';
  imagen?: string;
  noindex?: boolean;
  jsonld?: object | object[];
  fecha?: Date;
  actualizado?: Date;
}
const { titulo, descripcion, tipo = 'website', imagen = '/og/default.png', noindex = false, jsonld, fecha, actualizado } = Astro.props;

const tituloCompleto = titulo === SITIO.nombre ? `${SITIO.nombre} · Más contexto, menos ruido` : `${titulo} · ${SITIO.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenAbs = new URL(imagen, Astro.site).href;
const ld = jsonld && JSON.stringify(jsonld).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITIO.nombre}: ${SITIO.eslogan}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />
    {tipo === 'article' && fecha && <meta property="article:published_time" content={fecha.toISOString()} />}
    {tipo === 'article' && actualizado && <meta property="article:modified_time" content={actualizado.toISOString()} />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f0f11" />
    <meta name="color-scheme" content="dark" />
    <link rel="alternate" type="application/rss+xml" title={`${SITIO.nombre} · RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SaltarContenido />
    <Cabecera />
    <slot />
    <Pie />
    <Buscador />
    <script>
      import '../scripts/menu.ts';
      import '../scripts/buscador.ts';
      import '../scripts/codigo.ts';
      import '../scripts/toc.ts';
      import '../scripts/progreso.ts';
      import '../scripts/aprender.ts';
      import '../scripts/mermaid.ts';
    </script>
  </body>
</html>
